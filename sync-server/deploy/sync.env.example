# open 自助注册，invite 邀请注册，closed 仅允许已有账号登录。
FINESHELL_SYNC_REGISTRATION=open
FINESHELL_SYNC_MAIL_PROVIDER=smtp
FINESHELL_SYNC_MAIL_FROM=
FINESHELL_SYNC_SMTP_HOST=
FINESHELL_SYNC_SMTP_PORT=465
FINESHELL_SYNC_SMTP_USER=
FINESHELL_SYNC_SMTP_PASSWORD=
FINESHELL_SYNC_RESEND_API_KEY=
# 启用 OPAQUE 时生成一次随机服务配置，并和配置文件一起单独备份。
