{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "栈渡",
  "mainBinaryName": "ZhanDu",
  "bundle": {
    "publisher": "ZhanDu",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "template": "windows/installer.nsi"
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "8ecb576d-3fea-54f9-8b41-f1b1b254cf70",
        "template": "windows/main.wxs"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "栈渡",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "parent": "main",
        "skipTaskbar": true,
        "title": "设置",
        "url": "index.html#view=settings",
        "width": 860,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "shortcut-guide",
        "title": "快捷键与操作",
        "url": "index.html#view=shortcuts",
        "width": 780,
        "height": 560,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "focus": false,
        "visible": false
      }
    ]
  }
}
